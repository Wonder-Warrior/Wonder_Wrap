<Page
    x:Class="WonderWrapWidget.ReplayWidgetPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    Background="#FF181A1F">

    <Page.Resources>
        <!-- Fluent dark capture tile button -->
        <Style x:Key="CaptureTileButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="56" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="#FF23262E" />
            <Setter Property="Foreground" Value="#FFF0F2F5" />
            <Setter Property="BorderBrush" Value="#FF303540" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="#FF2E323C" />
                                            <Setter Target="RootBorder.BorderBrush" Value="#FF484E5C" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="#FF1E2128" />
                                            <Setter Target="RootBorder.BorderBrush" Value="#FF5C6374" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="RootBorder.Background" Value="#FF1D2026" />
                                            <Setter Target="RootBorder.BorderBrush" Value="#FF272B33" />
                                            <Setter Target="RootBorder.Opacity" Value="0.40" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact pill icon button for Folder & Settings -->
        <Style x:Key="SmallIconPillButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Background" Value="#FF22262E" />
            <Setter Property="BorderBrush" Value="#FF303540" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="PillBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="PillBorder.Background" Value="#FF2E323C" />
                                            <Setter Target="PillBorder.BorderBrush" Value="#FF484E5C" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="PillBorder.Background" Value="#FF1E2128" />
                                            <Setter Target="PillBorder.BorderBrush" Value="#FF5C6374" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="PillBorder.Opacity" Value="0.40" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Flat Capture-style bottom link button -->
        <Style x:Key="CapturesLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#FFF1F3F5" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,5,8,5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="LinkBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="LinkBorder.Background" Value="#FF262A33" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="LinkBorder.Background" Value="#FF1E2128" />
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <VisualState.Setters>
                                            <Setter Target="LinkBorder.Opacity" Value="0.42" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="14,10,14,10">
            <!-- Row 0: Four Capture-style rounded square icon tiles -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Tile 1: Screenshot -->
                <Button
                    x:Name="ScreenshotButton"
                    Grid.Column="0"
                    Style="{StaticResource CaptureTileButtonStyle}"
                    Click="ScreenshotButton_Click"
                    ToolTipService.ToolTip="Take screenshot"
                    IsEnabled="False">
                    <FontIcon
                        FontFamily="Segoe MDL2 Assets"
                        Glyph="&#xEB9F;"
                        FontSize="18"
                        Foreground="#FFE8EAED" />
                </Button>

                <!-- Tile 2: Instant Replay (native Captures look) -->
                <Button
                    x:Name="SaveButton"
                    Grid.Column="1"
                    Style="{StaticResource CaptureTileButtonStyle}"
                    Click="SaveButton_Click"
                    ToolTipService.ToolTip="Instant Replay activates while gaming"
                    IsEnabled="False">
                    <FontIcon
                        x:Name="SaveIcon"
                        FontFamily="Segoe MDL2 Assets"
                        Glyph="&#xE81C;"
                        FontSize="18"
                        Foreground="#FFE8EAED" />
                </Button>

                <!-- Tile 3: Start / Stop manual recording (circle -> red stop square) -->
                <Button
                    x:Name="RecordButton"
                    Grid.Column="2"
                    Style="{StaticResource CaptureTileButtonStyle}"
                    Click="RecordButton_Click"
                    ToolTipService.ToolTip="Start recording"
                    IsEnabled="False">
                    <Grid>
                        <Ellipse
                            x:Name="RecordDot"
                            Width="14"
                            Height="14"
                            Fill="#FFE8EAED" />
                        <Rectangle
                            x:Name="StopSquare"
                            Width="13"
                            Height="13"
                            RadiusX="2"
                            RadiusY="2"
                            Fill="#FFEF4444"
                            Visibility="Collapsed" />
                    </Grid>
                </Button>

                <!-- Tile 4: Toggle Microphone On / Off -->
                <Button
                    x:Name="MuteButton"
                    Grid.Column="3"
                    Style="{StaticResource CaptureTileButtonStyle}"
                    Click="MuteButton_Click"
                    ToolTipService.ToolTip="Turn mic on / off while recording"
                    IsEnabled="False">
                    <FontIcon
                        x:Name="MuteIcon"
                        FontFamily="Segoe MDL2 Assets"
                        Glyph="&#xE720;"
                        FontSize="18"
                        Foreground="#FFE8EAED" />
                </Button>
            </Grid>

            <!-- Divider -->
            <Border Height="1" Background="#FF2B303A" Margin="0,12,0,9" />

            <!-- Bottom Row: "See my captures" + Folder Icon + Settings Icon + Status Pill -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="OpenCapturesButton"
                    Grid.Column="0"
                    Style="{StaticResource CapturesLinkButtonStyle}"
                    Click="OpenCapturesButton_Click"
                    ToolTipService.ToolTip="Open captures folder"
                    IsEnabled="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontFamily="Segoe MDL2 Assets"
                            Glyph="&#xE8B2;"
                            FontSize="15"
                            Foreground="#FFE8EAED"
                            VerticalAlignment="Center" />
                        <TextBlock
                            Text="See my captures"
                            FontSize="13"
                            Foreground="#FFF1F3F5"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Settings gear pill (cleanly replaces redundant folder icon) -->
                <Button
                    x:Name="SettingsButton"
                    Grid.Column="1"
                    Style="{StaticResource SmallIconPillButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,6,0"
                    Click="SettingsButton_Click"
                    ToolTipService.ToolTip="Settings"
                    IsEnabled="False">
                    <FontIcon
                        x:Name="SettingsIcon"
                        FontFamily="Segoe MDL2 Assets"
                        Glyph="&#xE713;"
                        FontSize="12.5"
                        Foreground="#FFD5DAE2" />
                </Button>

                <!-- Live status pill -->
                <Border
                    Grid.Column="2"
                    Background="#FF22262E"
                    BorderBrush="#FF303540"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="7,3,7,3"
                    VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="5">
                        <Ellipse
                            x:Name="StatusDot"
                            Width="7"
                            Height="7"
                            Fill="#FF6B7280"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="StatusMetaText"
                            Text="Offline"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="#FF9CA3AF"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Collapsible Wonder Wrap Settings Drawer (branded only when open) -->
            <Border
                x:Name="SettingsPanel"
                Visibility="Collapsed"
                Background="#FF1E2128"
                BorderBrush="#66A8FF00"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10,9,10,9"
                Margin="0,10,0,0">
                <StackPanel Spacing="8">
                    <!-- Header -->
                    <Grid>
                        <TextBlock
                            Text="WONDER WRAP · SETTINGS"
                            FontSize="10.5"
                            FontWeight="Bold"
                            CharacterSpacing="80"
                            Foreground="#FFA8FF00"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="EncoderBadgeText"
                            Text="NVENC"
                            FontSize="10"
                            Foreground="#FF9CA3AF"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                    </Grid>

                    <!-- Row: Buffer Length & FPS (numeric inputs with constraints; 0 = full / match game) -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="Replay sec (0 = full)" FontSize="10.5" Foreground="#FF9CA3AF" />
                            <TextBox
                                x:Name="BufferInput"
                                InputScope="Number"
                                MaxLength="4"
                                PlaceholderText="0 = full"
                                FontSize="11.5"
                                ToolTipService.ToolTip="0 = record entire game session, or 5 to 7200 sec"
                                LostFocus="NumericInput_LostFocus"
                                KeyDown="NumericInput_KeyDown" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="FPS (0 = game)" FontSize="10.5" Foreground="#FF9CA3AF" />
                            <TextBox
                                x:Name="FpsInput"
                                InputScope="Number"
                                MaxLength="3"
                                PlaceholderText="0 = game"
                                FontSize="11.5"
                                ToolTipService.ToolTip="0 = match game FPS (VFR), or 15 to 240 FPS"
                                LostFocus="NumericInput_LostFocus"
                                KeyDown="NumericInput_KeyDown" />
                        </StackPanel>
                    </Grid>

                    <!-- Row: Video Bitrate & Audio Bitrate -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="3">
                            <TextBlock Text="Video Mbps (2-100)" FontSize="10.5" Foreground="#FF9CA3AF" />
                            <TextBox
                                x:Name="VideoBitrateInput"
                                InputScope="Number"
                                MaxLength="3"
                                PlaceholderText="18"
                                FontSize="11.5"
                                ToolTipService.ToolTip="Video bitrate in Mbps (2 to 100)"
                                LostFocus="NumericInput_LostFocus"
                                KeyDown="NumericInput_KeyDown" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="Audio kbps (64-320)" FontSize="10.5" Foreground="#FF9CA3AF" />
                            <TextBox
                                x:Name="AudioBitrateInput"
                                InputScope="Number"
                                MaxLength="3"
                                PlaceholderText="192"
                                FontSize="11.5"
                                ToolTipService.ToolTip="Audio bitrate in kbps (64 to 320)"
                                LostFocus="NumericInput_LostFocus"
                                KeyDown="NumericInput_KeyDown" />
                        </StackPanel>
                    </Grid>

                    <!-- Row: Hotkeys (click & press any key combo) -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Hotkeys (click &amp; press keys)" FontSize="10.5" Foreground="#FF9CA3AF" />
                        <Grid ColumnSpacing="8" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="2">
                                <TextBlock Text="Replay" FontSize="9.5" Foreground="#FF6B7280" />
                                <TextBox
                                    x:Name="HotkeyInput"
                                    IsReadOnly="True"
                                    PlaceholderText="Win+Alt+G"
                                    FontSize="11"
                                    ToolTipService.ToolTip="Click and press Replay hotkey"
                                    PreviewKeyDown="HotkeyInput_PreviewKeyDown" />
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="2">
                                <TextBlock Text="Record" FontSize="9.5" Foreground="#FF6B7280" />
                                <TextBox
                                    x:Name="RecordHotkeyInput"
                                    IsReadOnly="True"
                                    PlaceholderText="Win+Alt+R"
                                    FontSize="11"
                                    ToolTipService.ToolTip="Click and press Record hotkey"
                                    PreviewKeyDown="HotkeyInput_PreviewKeyDown" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="2">
                                <TextBlock Text="Screenshot" FontSize="9.5" Foreground="#FF6B7280" />
                                <TextBox
                                    x:Name="ScreenshotHotkeyInput"
                                    IsReadOnly="True"
                                    PlaceholderText="Win+Alt+PrintScreen"
                                    FontSize="11"
                                    ToolTipService.ToolTip="Click and press Screenshot hotkey"
                                    PreviewKeyDown="HotkeyInput_PreviewKeyDown" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="2">
                                <TextBlock Text="Mic" FontSize="9.5" Foreground="#FF6B7280" />
                                <TextBox
                                    x:Name="MicHotkeyInput"
                                    IsReadOnly="True"
                                    PlaceholderText="Win+Alt+M"
                                    FontSize="11"
                                    ToolTipService.ToolTip="Click and press Mic mute hotkey"
                                    PreviewKeyDown="HotkeyInput_PreviewKeyDown" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Row: Toggles (Game-Only & Show Cursor) -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <CheckBox
                            x:Name="GameOnlyCheck"
                            Grid.Column="0"
                            Content="Game-only"
                            FontSize="11.5"
                            Checked="SettingsControl_Changed"
                            Unchecked="SettingsControl_Changed" />

                        <CheckBox
                            x:Name="CursorCheck"
                            Grid.Column="1"
                            Content="Show cursor"
                            FontSize="11.5"
                            Checked="SettingsControl_Changed"
                            Unchecked="SettingsControl_Changed" />
                    </Grid>

                    <!-- Row: Active detected game + 1-click "Not a game" ignore button -->
                    <Grid x:Name="ActiveGameRow" Visibility="Collapsed" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="ActiveGameText"
                            Grid.Column="0"
                            Text=""
                            FontSize="10.5"
                            Foreground="#FFD5DAE2"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            Content="Not a game"
                            FontSize="10.5"
                            Padding="7,2,7,2"
                            CornerRadius="5"
                            Background="#FF282C36"
                            Foreground="#FFF87171"
                            Click="IgnoreGameButton_Click" />
                    </Grid>

                    <!-- Row: Auto-update banner (shown when a newer GitHub Release is available) -->
                    <Grid x:Name="UpdateRow" Visibility="Collapsed" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="UpdateText"
                            Grid.Column="0"
                            Text="Update available"
                            FontSize="10.5"
                            FontWeight="SemiBold"
                            Foreground="#FFA8FF00"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                        <Button
                            x:Name="UpdateButton"
                            Grid.Column="1"
                            Content="Update"
                            FontSize="10.5"
                            FontWeight="SemiBold"
                            Padding="8,2,8,2"
                            CornerRadius="5"
                            Background="#FFA8FF00"
                            Foreground="#FF14161B"
                            Click="UpdateButton_Click" />
                    </Grid>

                    <!-- Row: Capture folder path + Browse -->
                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="FolderPathText"
                            Grid.Column="0"
                            Text="Videos\Replays"
                            FontSize="10.5"
                            Foreground="#FF9CA3AF"
                            TextTrimming="CharacterEllipsis"
                            VerticalAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            Content="Browse"
                            FontSize="11"
                            Padding="8,3,8,3"
                            CornerRadius="5"
                            Background="#FF282C36"
                            Foreground="#FFA8FF00"
                            Click="ChangeFolderButton_Click" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
